{
  "$schema": "https://beacon.internal/token-schema-1.json",
  "name": "beacon",
  "version": "1.0.0",
  "description": "Beacon design tokens — machine-readable export for non-CSS consumers (Go templates, JS theme.js, native). Mirrors tokens.css. Source of truth is tokens.css; regenerate this on change.",
  "meta": {
    "geometryNote": "Machined: radius 0 everywhere except radiusPill. Hairline 1px / armed 2px borders.",
    "accentNote": "Accent is per-app and overrides --accent at the html element. accent.dim/soft/glow/contrast derive from it via color-mix in CSS; precomputed values here are for the default amber.",
    "a11y": "All text/lamp values target WCAG AA on their own surface."
  },
  "accents": {
    "amber":    { "value": "#e8a820", "name": "amber" },
    "cyan":     { "value": "#38bdf8", "name": "cyan" },
    "green":    { "value": "#38d39f", "name": "signal-green" },
    "violet": { "value": "#f97347", "name": "ember", "note": "reserved accent" }
  },
  "type": {
    "families": {
      "display": "Chakra Petch",
      "mono": "IBM Plex Mono",
      "sans": "IBM Plex Sans"
    },
    "scale": {
      "micro": { "px": 10, "tracking": "0.16em", "transform": "uppercase", "family": "display", "role": "engraved label" },
      "11": { "px": 11 }, "12": { "px": 12 }, "13": { "px": 13, "role": "base" },
      "15": { "px": 15 }, "18": { "px": 18 }, "24": { "px": 24 }, "32": { "px": 32 }
    },
    "lineHeight": { "tight": 1.1, "snug": 1.25, "base": 1.5, "data": 1.35 },
    "dataRule": "data/metrics/ids use mono + tabular-nums"
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "12": 48, "16": 64, "grid": 4 },
  "radius": { "default": 0, "pill": 999 },
  "border": { "hair": 1, "armed": 2 },
  "control": { "sm": 24, "md": 30, "lg": 38 },
  "motion": {
    "ease": "cubic-bezier(0.2,0.6,0.2,1)",
    "easeOut": "cubic-bezier(0.16,1,0.3,1)",
    "durFast": 90, "dur": 160, "durSlow": 320, "boot": 500,
    "keyframes": ["boot-in", "rail-in", "arm-breathe", "lamp-pulse", "shimmer", "sweep", "bump", "radar"],
    "reducedMotion": "core ships a prefers-reduced-motion:reduce block that neutralizes all animation/transition"
  },
  "statusModel": {
    "severity": { "critical": "error", "high": "high", "medium": "warn", "low": "info", "info": "neutral" },
    "runState": { "queued": "neutral", "running": "info+live", "done": "success", "failed": "error", "cancelled": "muted" },
    "liveness": { "connecting": "warn+live", "connected": "success", "reconnecting": "high+live", "offline": "error" }
  },
  "themes": {
    "dark": {
      "surfaces": { "bg": "#11141a", "surface": "#161a21", "surface2": "#1b2028", "surface3": "#212732", "raised": "#262d39" },
      "lines": { "border": "#2b3340", "borderSoft": "#222934", "borderStrong": "#3a4453" },
      "text": { "text": "#e7ebf1", "textDim": "#aab3c0", "muted": "#818d9c" },
      "accentDefault": { "accent": "#e8a820", "contrast": "#14110a" },
      "lamps": { "success": "#34d399", "warn": "#f5c542", "error": "#f1564a", "info": "#57b6f2", "neutral": "#8a96a4", "high": "#f5854a" },
      "terminal": { "bg": "#0b0e13", "fg": "#ccd5e0", "dim": "#5d6675" }
    },
    "light": {
      "surfaces": { "bg": "#e8e4db", "surface": "#f1eee7", "surface2": "#ded9cf", "surface3": "#d2ccc0", "raised": "#f6f3ec" },
      "lines": { "border": "#c5beb0", "borderSoft": "#d6d0c4", "borderStrong": "#a59d8b" },
      "text": { "text": "#201d17", "textDim": "#4f4a3f", "muted": "#645e51" },
      "accentDefault": { "accent": "#e8a820", "contrast": "#14110a" },
      "lamps": { "success": "#157f55", "warn": "#9a6b07", "error": "#c23128", "info": "#1f6fb0", "neutral": "#5f6873", "high": "#b85a16" },
      "terminal": { "bg": "#14120d", "fg": "#ded7c8", "dim": "#8a8270" }
    },
    "wall": {
      "surfaces": { "bg": "#000000", "surface": "#060809", "surface2": "#0b0e12", "surface3": "#11151a", "raised": "#141a20" },
      "lines": { "border": "#232a33", "borderSoft": "#161c23", "borderStrong": "#39434f" },
      "text": { "text": "#f6f9fc", "textDim": "#c4ccd6", "muted": "#93a0af" },
      "accentDefault": { "accent": "#e8a820", "contrast": "#0a0700" },
      "lamps": { "success": "#3ef0a8", "warn": "#ffd24a", "error": "#ff5b4d", "info": "#61c2ff", "neutral": "#95a3b3", "high": "#ff924f" },
      "terminal": { "bg": "#000000", "fg": "#dbe4ee", "dim": "#5f6b7a" },
      "typeScaleMultiplier": 1.18
    }
  }
}
